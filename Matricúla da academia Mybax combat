    def coletar_condicoes(self):
        condicoes = [c for c, v in self.check_vars.items() if v.get()]
        if self.var_outra.get():
            outra = self.entry_outra_condicao.get().strip()
            if outra:
                condicoes.append(f"Outra: {outra}")
        return condicoes

    def limpar_condicoes(self):
        for var in self.check_vars.values():
            var.set(False)
        self.var_outra.set(False)
        self.entry_outra_condicao.delete(0, tk.END)

    def atualizar_lista(self, filtro=None):
        for item in self.tree.get_children():
            self.tree.delete(item)

        for indice, aluno in enumerate(self.alunos):
            if filtro and filtro not in aluno["nome"].lower() and filtro not in aluno["cpf"]:
                continue
            self.tree.insert(
                "", tk.END, iid=str(indice),
                values=(
                    aluno["nome"], formata_cpf(aluno["cpf"]), aluno["telefone"],
                    aluno["plano"], aluno.get("pagamento", "-"),
                ),
            )
        self.label_contador.config(text=f"Total de matriculados: {len(self.alunos)}")

    def matricular(self):
        nome = self.entry_nome.get().strip()
        idade_txt = self.entry_idade.get().strip()
        cpf = self.entry_cpf.get().strip()
        nascimento = self.entry_nascimento.get().strip()
        telefone = self.entry_telefone.get().strip()
        endereco = self.entry_endereco.get().strip()
        plano = self.combo_plano.get().strip()
        pagamento = self.combo_pagamento.get().strip()

        if not all([nome, idade_txt, cpf, nascimento, telefone, endereco, plano, pagamento]):
            messagebox.showwarning("Aviso", "Preencha todos os campos antes de matricular.")
            return

        if not valida_nome(nome):
            messagebox.showerror(
                "Erro",
                "Nome inválido. Digite o nome completo, sem números ou símbolos, "
                "e cada parte do nome deve ter pelo menos 2 letras.",
            )
            return

        if not idade_txt.isdigit():
            messagebox.showerror("Erro", "A idade deve conter apenas números.")
            return

        if not valida_cpf(cpf):
            messagebox.showerror("Erro", "CPF inválido. Verifique os números digitados.")
            return

        data_valida, idade_calculada = valida_data_nascimento(nascimento)
        if not data_valida:
            messagebox.showerror("Erro", "Data de nascimento inválida. Use o formato dd/mm/aaaa.")
            return

        if not valida_telefone(telefone):
            messagebox.showerror("Erro", "Telefone inválido. Informe DDD + número (10 ou 11 dígitos).")
            return

        if not valida_endereco(endereco):
            messagebox.showerror("Erro", "Endereço muito curto ou inválido.")
            return

        idade = int(idade_txt)
        if idade != idade_calculada:
            confirmar = messagebox.askyesno(
                "Divergência de idade",
                f"A idade informada ({idade_txt}) não corresponde à idade calculada "
                f"pela data de nascimento ({idade_calculada}). Deseja continuar mesmo assim?",
            )
            if not confirmar:
                return

        dados_responsavel = None
        if idade < IDADE_MINIMA_SEM_RESPONSAVEL:
            resp_nome = self.entry_resp_nome.get().strip()
            resp_cpf = self.entry_resp_cpf.get().strip()
            resp_telefone = self.entry_resp_telefone.get().strip()
            resp_parentesco = self.entry_resp_parentesco.get().strip()

            if not all([resp_nome, resp_cpf, resp_telefone, resp_parentesco]):
                messagebox.showwarning(
                    "Aviso",
                    f"Alunos com menos de {IDADE_MINIMA_SEM_RESPONSAVEL} anos precisam "
                    "dos dados completos do responsável.",
                )
                return

            if not valida_nome(resp_nome):
                messagebox.showerror("Erro", "Nome do responsável inválido.")
                return

            if not valida_cpf(resp_cpf):
                messagebox.showerror("Erro", "CPF do responsável inválido.")
                return

            if not valida_telefone(resp_telefone):
                messagebox.showerror("Erro", "Telefone do responsável inválido.")
                return

            if not self.var_autorizacao.get():
                messagebox.showwarning(
                    "Aviso",
                    "É necessário marcar a autorização do responsável para matricular menores de "
                    f"{IDADE_MINIMA_SEM_RESPONSAVEL} anos.",
                )
                return

            dados_responsavel = {
                "nome": resp_nome,
                "cpf": re.sub(r"\D", "", resp_cpf),
                "telefone": resp_telefone,
                "parentesco": resp_parentesco,
            }

        cpf_limpo = re.sub(r"\D", "", cpf)
        for existente in self.alunos:
            if existente["cpf"] == cpf_limpo:
                messagebox.showerror("Erro", "Já existe um aluno cadastrado com este CPF.")
                return

        aluno = {
            "nome": nome,
            "idade": idade_txt,
            "cpf": cpf_limpo,
            "nascimento": nascimento,
            "telefone": telefone,
            "endereco": endereco,
            "plano": plano,
            "pagamento": pagamento,
            "condicoes_saude": self.coletar_condicoes(),
            "responsavel": dados_responsavel,
        }
        self.alunos.append(aluno)
        self.atualizar_lista()

        for entry in (
            self.entry_nome, self.entry_idade, self.entry_cpf, self.entry_nascimento,
            self.entry_telefone, self.entry_endereco, self.entry_resp_nome,
            self.entry_resp_cpf, self.entry_resp_telefone, self.entry_resp_parentesco,
        ):
            entry.delete(0, tk.END)
        self.combo_plano.current(0)
        self.combo_pagamento.current(0)
        self.var_autorizacao.set(False)
        self.limpar_condicoes()
        self.entry_nome.focus()

        self.salvar_dados(mostrar_aviso=False)

    def ver_detalhes(self):
        selecionado = self.tree.selection()
        if not selecionado:
            messagebox.showwarning("Aviso", "Selecione um aluno para ver os detalhes.")
            return

        indice = int(selecionado[0])
        aluno = self.alunos[indice]
        condicoes = ", ".join(aluno["condicoes_saude"]) if aluno["condicoes_saude"] else "Nenhuma informada"

        detalhes = (
            f"Nome: {aluno['nome']}\n"
            f"Idade: {aluno['idade']}\n"
            f"CPF: {formata_cpf(aluno['cpf'])}\n"
            f"Nascimento: {aluno['nascimento']}\n"
            f"Telefone: {aluno['telefone']}\n"
            f"Endereço: {aluno['endereco']}\n"
            f"Plano: {aluno['plano']}\n"
            f"Forma de pagamento: {aluno.get('pagamento', '-')}\n"
            f"Condições de saúde: {condicoes}\n"
        )

        responsavel = aluno.get("responsavel")
        if responsavel:
            detalhes += (
                f"\n--- Responsável ---\n"
                f"Nome: {responsavel['nome']}\n"
                f"CPF: {formata_cpf(responsavel['cpf'])}\n"
                f"Telefone: {responsavel['telefone']}\n"
                f"Parentesco: {responsavel['parentesco']}\n"
            )

        messagebox.showinfo("Detalhes do aluno", detalhes)

    def remover_selecionado(self):
        selecionado = self.tree.selection()
        if not selecionado:
            messagebox.showwarning("Aviso", "Selecione um aluno para remover.")
            return

        indice = int(selecionado[0])
        confirmar = messagebox.askyesno(
            "Confirmar remoção", f"Deseja remover '{self.alunos[indice]['nome']}' da lista?"
        )
        if confirmar:
            del self.alunos[indice]
            self.atualizar_lista()
            self.salvar_dados(mostrar_aviso=False)

    def limpar_lista(self):
        if not self.alunos:
            return
        confirmar = messagebox.askyesno(
            "Confirmar", "Deseja realmente limpar toda a lista de matriculados?"
        )
        if confirmar:
            self.alunos = []
            self.atualizar_lista()
            self.salvar_dados(mostrar_aviso=False)

    def buscar_aluno(self, event=None):
        termo = self.entry_busca.get().strip().lower()
        self.atualizar_lista(filtro=termo if termo else None)

    def salvar_dados(self, mostrar_aviso=True):
        try:
            with open(ARQUIVO_DADOS, "w", encoding="utf-8") as f:
                json.dump(self.alunos, f, ensure_ascii=False, indent=2)
            if mostrar_aviso:
                messagebox.showinfo("Sucesso", "Dados salvos com sucesso!")
        except Exception as e:
            if mostrar_aviso:
                messagebox.showerror("Erro", f"Não foi possível salvar os dados.\n{e}")

    def carregar_dados(self):
        if os.path.exists(ARQUIVO_DADOS):
            try:
                with open(ARQUIVO_DADOS, "r", encoding="utf-8") as f:
                    self.alunos = json.load(f)
            except Exception:
                self.alunos = []
        self.atualizar_lista()


