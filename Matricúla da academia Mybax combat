def valida_cpf(cpf):
    cpf = re.sub(r"\D", "", cpf)
    if len(cpf) != 11:
        return False
    if cpf == cpf[0] * 11:
        return False

    soma = sum(int(cpf[i]) * (10 - i) for i in range(9))
    resto = (soma * 10) % 11
    digito1 = 0 if resto == 10 else resto
    if digito1 != int(cpf[9]):
        return False

    soma = sum(int(cpf[i]) * (11 - i) for i in range(10))
    resto = (soma * 10) % 11
    digito2 = 0 if resto == 10 else resto
    if digito2 != int(cpf[10]):
        return False

    return True


def formata_cpf(cpf):
    cpf = re.sub(r"\D", "", cpf)
    return f"{cpf[0:3]}.{cpf[3:6]}.{cpf[6:9]}-{cpf[9:11]}"


def valida_telefone(tel):
    tel = re.sub(r"\D", "", tel)
    return len(tel) in (10, 11)


def valida_data_nascimento(data_str):
    try:
        data = datetime.strptime(data_str.strip(), "%d/%m/%Y")
    except ValueError:
        return False, None

    hoje = datetime.now()
    if data > hoje:
        return False, None

    idade = hoje.year - data.year - ((hoje.month, hoje.day) < (data.month, data.day))
    if idade < 0 or idade > 120:
        return False, None

    return True, idade


def valida_endereco(endereco):
    return len(endereco.strip()) >= 5


def valida_nome(nome):
    nome = nome.strip()
    if len(re.sub(r"\s", "", nome)) <= 2:
        return False
    if not re.fullmatch(r"[A-Za-zÀ-ÖØ-öø-ÿ' ]+", nome):
        return False
    partes = nome.split()
    if any(len(parte) < 2 for parte in partes):
        return False
    return True


