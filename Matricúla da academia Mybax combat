    def atualizar_lista(self):
        self.listbox.delete(0, tk.END)
        for aluno in self.alunos:
            texto = (
                f"{aluno['nome']} (Idade: {aluno['idade']}, "
                f"Tel: {aluno['telefone']}) - Plano: {aluno['plano']}"
            )
            self.listbox.insert(tk.END, texto)
        self.label_contador.config(
            text=f"Total de matriculados: {len(self.alunos)}"
        )

    def matricular(self):
        nome = self.entry_nome.get().strip()
        idade = self.entry_idade.get().strip()
        telefone = self.entry_telefone.get().strip()
        plano = self.combo_plano.get().strip()

        if not nome or not idade or not telefone or not plano:
            messagebox.showwarning(
                "Aviso", "Por favor, preencha todos os campos antes de matricular."
            )
            return

        if not idade.isdigit():
            messagebox.showerror("Erro", "A idade deve conter apenas números.")
            return

        aluno = {
            "nome": nome,
            "idade": idade,
            "telefone": telefone,
            "plano": plano,
        }
        self.alunos.append(aluno)
        self.atualizar_lista()

        self.entry_nome.delete(0, tk.END)
        self.entry_idade.delete(0, tk.END)
        self.entry_telefone.delete(0, tk.END)
        self.combo_plano.current(0)
        self.entry_nome.focus()

        self.salvar_dados(mostrar_aviso=False)

    def remover_selecionado(self):
        selecionado = self.listbox.curselection()
        if not selecionado:
            messagebox.showwarning("Aviso", "Selecione um aluno para remover.")
            return

        indice = selecionado[0]
        confirmar = messagebox.askyesno(
            "Confirmar remoção",
            f"Deseja remover '{self.alunos[indice]['nome']}' da lista?",
        )
        if confirmar:
            del self.alunos[indice]
            self.atualizar_lista()
            self.salvar_dados(mostrar_aviso=False)

    def limpar_lista(self):
        if not self.alunos:
            return
        confirmar = messagebox.askyesno(
            "Confirmar", "Deseja realmente limpar toda a lista de matriculados?"
        )
        if confirmar:
            self.alunos = []
            self.atualizar_lista()
            self.salvar_dados(mostrar_aviso=False)

    def buscar_aluno(self, event=None):
        termo = self.entry_busca.get().strip().lower()
        self.listbox.delete(0, tk.END)
        for aluno in self.alunos:
            if termo in aluno["nome"].lower():
                texto = (
                    f"{aluno['nome']} (Idade: {aluno['idade']}, "
                    f"Tel: {aluno['telefone']}) - Plano: {aluno['plano']}"
                )
                self.listbox.insert(tk.END, texto)

    def salvar_dados(self, mostrar_aviso=True):
        try:
            with open(ARQUIVO_DADOS, "w", encoding="utf-8") as f:
                json.dump(self.alunos, f, ensure_ascii=False, indent=2)
            if mostrar_aviso:
                messagebox.showinfo("Sucesso", "Dados salvos com sucesso!")
        except Exception as e:
            if mostrar_aviso:
                messagebox.showerror("Erro", f"Não foi possível salvar os dados.\n{e}")

    def carregar_dados(self):
        if os.path.exists(ARQUIVO_DADOS):
            try:
                with open(ARQUIVO_DADOS, "r", encoding="utf-8") as f:
                    self.alunos = json.load(f)
            except Exception:
                self.alunos = []
        self.atualizar_lista()


if __name__ == "__main__":
    root = tk.Tk()
    app = AcademiaApp(root)
    root.mainloop()

    import tkinter as tk
from tkinter import ttk, messagebox
import json
