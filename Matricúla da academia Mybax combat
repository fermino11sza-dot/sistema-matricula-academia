    # ---------- Validadores de teclas (bloqueiam a digitação errada) ----------
    def _permite_nome(self, texto_novo):
        return REGEX_NOME.fullmatch(texto_novo) is not None

    def _permite_numero(self, texto_novo):
        return texto_novo == "" or (texto_novo.isdigit() and len(texto_novo) <= 14)

    def _permite_data(self, texto_novo):
        return re.fullmatch(r"[\d/]{0,10}", texto_novo) is not None

    def _permite_endereco(self, texto_novo):
        return REGEX_ENDERECO.fullmatch(texto_novo) is not None

