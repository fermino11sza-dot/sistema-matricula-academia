    import tkinter as tk
from tkinter import ttk, messagebox
import json
import os
import re
from datetime import datetime

ARQUIVO_DADOS = "matriculados.json"

CONDICOES_SAUDE = [
    "Asma",
    "Diabetes",
    "Hipertensão",
    "Distrofia Muscular",
    "Problema Cardíaco",
    "Epilepsia",
    "Lesão/Cirurgia recente",
]

FORMAS_PAGAMENTO = ["Dinheiro", "Pix", "Cartão de Débito", "Cartão de Crédito", "Boleto"]

IDADE_MINIMA_SEM_RESPONSAVEL = 14

# ---------- Paleta de cores ----------
COR_PRETO_ABSOLUTO = "#000000"
COR_PRETO_HEADER = "#000000"
COR_BRANCO = "#FFFFFF"
COR_ENTRADA_BG = "#111111"
COR_BORDA = "#2A2A2A"
COR_AGUA_MARINHA = "#1BC4B5"
COR_AGUA_MARINHA_ESCURO = "#0E7A71"
FONTE_PADRAO = "Segoe UI"

REGEX_NOME = re.compile(r"^[A-Za-zÀ-ÖØ-öø-ÿ' ]*$")
REGEX_ENDERECO = re.compile(r"^[A-Za-zÀ-ÖØ-öø-ÿ0-9º°,.\-/ ]*$")


# ---------- Funções de validação de conteúdo ----------
def valida_cpf(cpf):
    cpf = re.sub(r"\D", "", cpf)
    if len(cpf) != 11:
        return False
    if cpf == cpf[0] * 11:
        return False

    soma = sum(int(cpf[i]) * (10 - i) for i in range(9))
    resto = (soma * 10) % 11
    digito1 = 0 if resto == 10 else resto
    if digito1 != int(cpf[9]):
        return False

    soma = sum(int(cpf[i]) * (11 - i) for i in range(10))
    resto = (soma * 10) % 11
    digito2 = 0 if resto == 10 else resto
    if digito2 != int(cpf[10]):
        return False

    return True


def formata_cpf(cpf):
    cpf = re.sub(r"\D", "", cpf)
    return f"{cpf[0:3]}.{cpf[3:6]}.{cpf[6:9]}-{cpf[9:11]}"


def valida_telefone(tel):
    tel = re.sub(r"\D", "", tel)
    return len(tel) in (10, 11)


def valida_data_nascimento(data_str):
    data_str = data_str.strip()
    if not re.fullmatch(r"\d{2}/\d{2}/\d{4}", data_str):
        return False, None
    try:
        data = datetime.strptime(data_str, "%d/%m/%Y")
    except ValueError:
        return False, None

    hoje = datetime.now()
    if data > hoje:
        return False, None

    idade = hoje.year - data.year - ((hoje.month, hoje.day) < (data.month, data.day))
    if idade < 0 or idade > 120:
        return False, None

    return True, idade


def valida_endereco(endereco):
    endereco = endereco.strip()
    if len(endereco) < 5:
        return False
    if not REGEX_ENDERECO.fullmatch(endereco):
        return False
    if not any(c.isalpha() for c in endereco):
        return False
    return True


def valida_nome(nome):
    nome = nome.strip()
    if len(re.sub(r"\s", "", nome)) <= 2:
        return False
    if not REGEX_NOME.fullmatch(nome):
        return False
    partes = nome.split()
    if any(len(parte) < 2 for parte in partes):
        return False
    return True


